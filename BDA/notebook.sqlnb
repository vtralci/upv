    value: ""
    languageId: markdown
  - kind: 1
    value: |
      # Práctica 4
    languageId: markdown
  - kind: 1
    value: ""
    languageId: markdown
  - kind: 2
    value: |
      select g.cod_gen, g.nombre, count(c.COD_PELI), avg(p.duracion)
      from genero g
          join clasificacion c on c.cod_gen = g.cod_gen
          join pelicula p on c.COD_PELI = p.COD_PELI
      group by g.cod_gen, g.nombre
      having count(c.COD_PELI) > 5
      order by g.nombre
    languageId: oracle-sql
  - kind: 1
    value: ""
    languageId: markdown
  - kind: 2
    value: |-
      select p.cod_peli, p.TITULO, count(c.COD_GEN)
      from pelicula p
          join clasificacion c on p.cod_peli = c.cod_peli
      where p.anyo > 2000
      group by p.cod_peli, p.titulo
      order by p.titulo
    languageId: oracle-sql
  - kind: 1
    value: ""
    languageId: markdown
  - kind: 2
    value: |-
      select p.cod_peli, p.titulo, count(distinct(act.cod_act)) as nAct
      from pelicula p
          join actua act on p.COD_PELI = act.COD_PELI
          join CLASIFICACION c on c.COD_PELI = p.COD_PELI
      group by p.COD_PELI, p.TITULO
      having count(distinct(c.cod_gen)) = 1
      order by p.TITULO
    languageId: oracle-sql
  - kind: 1
    value: ""
    languageId: markdown
  - kind: 2
    value: |
      select pa.cod_pais, pa.nombre, count(distinct(a.cod_act))
      from pais pa
          join actor a on pa.COD_PAIS = a.COD_PAIS
          join actua act on a.COD_ACT = act.cod_act
          join pelicula p on p.COD_PELI = act.COD_PELI
      where p.anyo between 1960 and 1969
      group by pa.COD_PAIS, pa.NOMBRE
      order by pa.NOMBRE
    languageId: oracle-sql
  - kind: 2
    value: >-
      select p.COD_PAIS, p.NOMBRE, count(a.COD_ACT) as cantidad

      from pais p
          left join actor a on a.cod_pais = p.cod_pais and a.nombre like '%George$'
      group by p.cod_pais, p.nombre

      order by p.nombre
    languageId: oracle-sql
  - kind: 2
    value: |-
      select p.cod_pelo, p.titulo, l.titulo
      from pelicula p
          left join 
      where
      union
    languageId: oracle-sql
  - kind: 1
    value: >-
      Obtener el código y el título de todos los libros de la base de datos de
      año posterior a 1980 junto con la

      cantidad de películas a que han dado lugar.
    languageId: markdown
  - kind: 1
    value: ""
    languageId: markdown
  - kind: 2
    value: |+
      select l.cod_lib, l.titulo, l.anyo, count(p.COD_PELI)
      from libro_peli l
          left join pelicula p on p.cod_lib = l.cod_lib
      where l.ANYO > 1980
      group by l.COD_LIB, l.titulo, l.anyo

    languageId: oracle-sql
  - kind: 1
    value: >-
      Obtener para todos los países que hay en la base de datos, el código, el
      nombre y la cantidad de actores

      que hay de ese país que hayan tenido un papel como “Secundario” en alguna
      película.
    languageId: markdown
  - kind: 2
    value: >-
      select p.cod_pais, p.nombre, count(distinct act.cod_act)

      from pais p
          left join actor a on p.COD_PAIS = a.COD_PAIS
          left join actua act on a.COD_ACT = act.COD_ACT and act.papel = 'Secundario'
      group by p.cod_pais, p.nombre
    languageId: oracle-sql
  - kind: 1
    value: ""
    languageId: markdown
  - kind: 2
    value: |
      select count(*)
      from actor a
    languageId: oracle-sql
